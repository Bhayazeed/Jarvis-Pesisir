# ── Mark-XL Environment Variables ──────────────────────────────────────────
# Copy this file to .env and replace with your real tokens:
#   copy .env.example .env

# Hugging Face token for private model access (Wav2Vec 2.0 STT)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# SI-Lab LLM API key (only needed if using "silab" as llm_provider)
SILAB_KEY=your_silab_key_here
